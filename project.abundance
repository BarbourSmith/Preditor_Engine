            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.87,
              "uniqueID": "id-436",
              "name": "Muffler",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-437",
                  "ioValues": [
                    {
                      "name": "number or geometry",
