                    {
                      "name": "shaftHeight",
                      "ioValue": 106
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Spark plug (NGK BP-6ES per manual) with boot and lead, in the side of the head.\n * Built in the cylinder's local frame (axis along +Z from the crank) and leaned\n * the same as the Cylinder and Head part. Dimensions approximate.\n */\nfunction run(tiltDeg: number = 25, shaftHeight: number = 106): Assembly {\n  const hex = (across, h) => {\n    try { return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h); }\n    catch (e) { return replicad.makeCylinder(across / 2, h); }\n  };\n  const z = 165;\n  let p = hex(20.6, 9).rotate(90, [0, 0, 0], [1, 0, 0]).translate(0, -62, z); // 13/16 in hex, Y -62..-71\n  p = p.fuse(replicad.makeCylinder(5.5, 10, [0, -71, z], [0, -1, 0]));        // insulator\n  p = p.fuse(replicad.makeCylinder(10, 30, [0, -78, z], [0, -1, 0]));         // boot, Y -78..-108\n  p = p.fuse(replicad.makeCylinder(3.5, 45, [-6, -98, z], [-1, 0, -0.35]));   // HT lead toward the coil\n  p = p.rotate(tiltDeg, [0, 0, 0], [0, 1, 0]).translate(0, 0, shaftHeight);\n  return new Assembly({ geometry: p, color: \"#151515\", tags: [\"spark plug\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Spark plug (NGK BP-6ES per manual) with boot and lead, in the side of the head.\n * Built in the cylinder's local frame (axis along +Z from the crank) and leaned\n * the same as the Cylinder and Head part. Dimensions approximate.\n */\nfunction run(tiltDeg = 25, shaftHeight = 106) {\n    const hex = (across, h) => {\n        try {\n            return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h);\n        }\n        catch (e) {\n            return replicad.makeCylinder(across / 2, h);\n        }\n    };\n    const z = 165;\n    let p = hex(20.6, 9).rotate(90, [0, 0, 0], [1, 0, 0]).translate(0, -62, z); // 13/16 in hex, Y -62..-71\n    p = p.fuse(replicad.makeCylinder(5.5, 10, [0, -71, z], [0, -1, 0])); // insulator\n    p = p.fuse(replicad.makeCylinder(10, 30, [0, -78, z], [0, -1, 0])); // boot, Y -78..-108\n    p = p.fuse(replicad.makeCylinder(3.5, 45, [-6, -98, z], [-1, 0, -0.35])); // HT lead toward the coil\n    p = p.rotate(tiltDeg, [0, 0, 0], [0, 1, 0]).translate(0, 0, shaftHeight);\n    return new Assembly({ geometry: p, color: \"#151515\", tags: [\"spark plug\"] });\n}\n"
                }
