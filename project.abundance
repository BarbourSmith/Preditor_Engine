              "uniqueID": "id-388",
              "name": "Carburetor",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-389",
                  "ioValues": [
                    {
                      "name": "number or geometry",
