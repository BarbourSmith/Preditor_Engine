            },
            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.75,
              "uniqueID": "id-391",
              "name": "Air Cleaner",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-392",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-393",
                  "interpreterVersion": 1,
                  "code": "/**\n * Air cleaner housing on the +X side over the carburetor, with cover seam,\n * intake slots and wing knob. The knob and the muffler outlet set the engine's\n * +X extent (368 mm / 14.5 in overall per retailer listings). Shape approximate.\n */\nfunction run(): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  let a = box(150, 208, -5, 150, 190, 300, 18);\n  try { a = a.fillet(8, (e) => e.inPlane(\"XY\", 300)); } catch (err) { console.warn(\"air cleaner fillet skipped\"); }\n  // Cover seam: shallow groove all round\n  a = a.cut(box(170.5, 172.5, -8, 153, 187, 303).cut(box(170.5, 172.5, -2, 147, 193, 297)));\n  // Intake slots underneath\n  for (let i = 0; i < 5; i++) {\n    const y = 20 + i * 22;\n    a = a.cut(box(180, 202, y, y + 6, 189, 193));\n  }\n  // Wing knob holding the cover\n  a = a.fuse(replicad.makeCylinder(14, 6.5, [207.5, 72, 245], [1, 0, 0]));\n  a = a.fuse(box(213, 218, 61, 83, 241, 249, 2));\n  return new Assembly({ geometry: a, color: \"#262626\", tags: [\"air cleaner\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Air cleaner housing on the +X side over the carburetor, with cover seam,\n * intake slots and wing knob. The knob and the muffler outlet set the engine's\n * +X extent (368 mm / 14.5 in overall per retailer listings). Shape approximate.\n */\nfunction run() {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    let a = box(150, 208, -5, 150, 190, 300, 18);\n    try {\n        a = a.fillet(8, (e) => e.inPlane(\"XY\", 300));\n    }\n    catch (err) {\n        console.warn(\"air cleaner fillet skipped\");\n    }\n    // Cover seam: shallow groove all round\n    a = a.cut(box(170.5, 172.5, -8, 153, 187, 303).cut(box(170.5, 172.5, -2, 147, 193, 297)));\n    // Intake slots underneath\n    for (let i = 0; i < 5; i++) {\n        const y = 20 + i * 22;\n        a = a.cut(box(180, 202, y, y + 6, 189, 193));\n    }\n    // Wing knob holding the cover\n    a = a.fuse(replicad.makeCylinder(14, 6.5, [207.5, 72, 245], [1, 0, 0]));\n    a = a.fuse(box(213, 218, 61, 83, 241, 249, 2));\n    return new Assembly({ geometry: a, color: \"#262626\", tags: [\"air cleaner\"] });\n}\n"
                }
              ],
