                  "interpreterVersion": 1,
                  "code": "/**\n * Predator 212 (item 69730) crankcase casting.\n * Frame: Z = 0 is the underside of the mounting feet, crankshaft axis runs along Y\n * at X = 0, Z = shaftHeight; the PTO (output) end points toward -Y.\n * Exact from the manual (pp. 20-21): hole spacing 162 mm, crank 66 mm from one\n * hole row, rows 75.5 mm apart (slots to 80.5 mm), shaft height 106 mm,\n * 4x 5/16-24 UNF holes on a 92 mm circle on the PTO face.\n * Body shape, ribs, bolts, plugs and the PTO face position along Y are approximate.\n */\nfunction run(\n  holeSpacingX: number = 162,   // mm, between mounting holes along X\n  crankToHole: number = 66,     // mm, crank axis to the -X hole row\n  rowSpacing: number = 75.5,    // mm, between hole rows (min)\n  slotLength: number = 5,       // mm, slots open the rows to 80.5\n  shaftHeight: number = 106,    // mm, feet to crank axis\n  ptoFaceY: number = -80,       // mm, PTO mounting face (approximate)\n  boltCircle: number = 92,      // mm, PTO bolt circle diameter\n): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  const hex = (across, h) => {\n    try { return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h); }\n    catch (e) { return replicad.makeCylinder(across / 2, h); }\n  };\n  const sh = shaftHeight;\n  const holeD = 9;\n  const xL = -crankToHole, xR = holeSpacingX - crankToHole;\n  const yRow0 = -40.5;              // round-hole row (PTO side)\n  const yRow1 = yRow0 + rowSpacing; // slotted row, opens +slotLength\n  const caseY0 = ptoFaceY + 5;\n  const bxL = xL + 12, bxR = xR - 20; // lower case walls, inside the hole rows\n\n  // Mounting base (feet)\n  let body = box(xL - 16, xR + 16, yRow0 - 17, yRow1 + slotLength + 17, 0, 12, 8);\n  // Lower crankcase and round upper case around the crank\n  body = body.fuse(box(bxL, bxR, caseY0, 58, 8, sh, 15));\n  body = body.fuse(replicad.makeCylinder(82, 58 - caseY0, [0, caseY0, sh], [0, 1, 0]));\n  // Stiffening ribs on both side walls\n  for (const y of [-55, -25, 5, 35]) {\n    body = body.fuse(box(bxL - 4, bxL, y, y + 4, 12, 75));\n    body = body.fuse(box(bxR, bxR + 4, y, y + 4, 12, 75));\n  }\n  // Foot gussets beside each hole row\n  for (const y of [yRow0 - 14, yRow1 + slotLength + 10]) {\n    body = body.fuse(box(bxL - 10, bxL, y, y + 4, 12, 30));\n    body = body.fuse(box(bxR, bxR + 10, y, y + 4, 12, 30));\n  }\n  // PTO flange (its face is the mounting face the shaft length is measured from)\n  body = body.fuse(replicad.makeCylinder(56, 5, [0, ptoFaceY, sh], [0, 1, 0]));\n  // Oil seal recess around the shaft\n  body = body.cut(replicad.makeCylinder(21, 2, [0, ptoFaceY - 0.01, sh], [0, 1, 0]));\n  // Crankcase cover parting line (groove round the upper case)\n  const gy = ptoFaceY + 30;\n  body = body.cut(replicad.makeCylinder(84, 1.5, [0, gy, sh], [0, 1, 0])\n    .cut(replicad.makeCylinder(80.8, 1.5, [0, gy, sh], [0, 1, 0])));\n  // Mounting holes and slots, through the feet only\n  for (const x of [xL, xR]) {\n    body = body.cut(replicad.makeCylinder(holeD / 2, 20, [x, yRow0, -4], [0, 0, 1]));\n    const slot = replicad.makeCylinder(holeD / 2, 20, [x, yRow1, -4], [0, 0, 1])\n      .fuse(replicad.makeCylinder(holeD / 2, 20, [x, yRow1 + slotLength, -4], [0, 0, 1]))\n      .fuse(box(x - holeD / 2, x + holeD / 2, yRow1, yRow1 + slotLength, -4, 16));\n    body = body.cut(slot);\n  }\n  // 4x 5/16-24 UNF tapped holes (6.9 mm tap drill, 15 mm deep) on the PTO face\n  const off = boltCircle / 2 / Math.SQRT2;\n  for (const [dx, dz] of [[off, off], [-off, off], [off, -off], [-off, -off]]) {\n    body = body.cut(replicad.makeCylinder(3.45, 16, [dx, ptoFaceY - 1, sh + dz], [0, 1, 0]));\n  }\n  // Six cover bolts on the PTO end, heads flush with the mounting face\n  for (const a of [30, 90, 150, 210, 270, 330]) {\n    const t = (a * Math.PI) / 180;\n    body = body.fuse(hex(10, 5).rotate(90, [0, 0, 0], [1, 0, 0]).translate(70 * Math.cos(t), caseY0, sh + 70 * Math.sin(t)));\n  }\n  // Oil drain plugs on both sides\n  body = body.fuse(replicad.makeCylinder(10, 5, [bxL, -50, 30], [-1, 0, 0]));\n  body = body.fuse(hex(14, 7).rotate(-90, [0, 0, 0], [0, 1, 0]).translate(bxL - 5, -50, 30));\n  body = body.fuse(replicad.makeCylinder(10, 5, [bxR, -50, 30], [1, 0, 0]));\n  body = body.fuse(hex(14, 7).rotate(90, [0, 0, 0], [0, 1, 0]).translate(bxR + 5, -50, 30));\n  // Oil fill neck and dipstick cap, angled up on the -X side\n  const dir = [-0.857, 0, 0.514];\n  const start = [-60, -50, 72];\n  const end = [start[0] + 30 * dir[0], start[1], start[2] + 30 * dir[2]];\n  body = body.fuse(replicad.makeCylinder(9, 30, start, dir));\n  body = body.fuse(replicad.makeCylinder(13, 10, end, dir));\n  body = body.fuse(replicad.makeCylinder(15, 3, end, dir));\n  return new Assembly({ geometry: body, color: \"#8C9096\", tags: [\"crankcase\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Predator 212 (item 69730) crankcase casting.\n * Frame: Z = 0 is the underside of the mounting feet, crankshaft axis runs along Y\n * at X = 0, Z = shaftHeight; the PTO (output) end points toward -Y.\n * Exact from the manual (pp. 20-21): hole spacing 162 mm, crank 66 mm from one\n * hole row, rows 75.5 mm apart (slots to 80.5 mm), shaft height 106 mm,\n * 4x 5/16-24 UNF holes on a 92 mm circle on the PTO face.\n * Body shape, ribs, bolts, plugs and the PTO face position along Y are approximate.\n */\nfunction run(holeSpacingX = 162, // mm, between mounting holes along X\ncrankToHole = 66, // mm, crank axis to the -X hole row\nrowSpacing = 75.5, // mm, between hole rows (min)\nslotLength = 5, // mm, slots open the rows to 80.5\nshaftHeight = 106, // mm, feet to crank axis\nptoFaceY = -80, // mm, PTO mounting face (approximate)\nboltCircle = 92) {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    const hex = (across, h) => {\n        try {\n            return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h);\n        }\n        catch (e) {\n            return replicad.makeCylinder(across / 2, h);\n        }\n    };\n    const sh = shaftHeight;\n    const holeD = 9;\n    const xL = -crankToHole, xR = holeSpacingX - crankToHole;\n    const yRow0 = -40.5; // round-hole row (PTO side)\n    const yRow1 = yRow0 + rowSpacing; // slotted row, opens +slotLength\n    const caseY0 = ptoFaceY + 5;\n    const bxL = xL + 12, bxR = xR - 20; // lower case walls, inside the hole rows\n    // Mounting base (feet)\n    let body = box(xL - 16, xR + 16, yRow0 - 17, yRow1 + slotLength + 17, 0, 12, 8);\n    // Lower crankcase and round upper case around the crank\n    body = body.fuse(box(bxL, bxR, caseY0, 58, 8, sh, 15));\n    body = body.fuse(replicad.makeCylinder(82, 58 - caseY0, [0, caseY0, sh], [0, 1, 0]));\n    // Stiffening ribs on both side walls\n    for (const y of [-55, -25, 5, 35]) {\n        body = body.fuse(box(bxL - 4, bxL, y, y + 4, 12, 75));\n        body = body.fuse(box(bxR, bxR + 4, y, y + 4, 12, 75));\n    }\n    // Foot gussets beside each hole row\n    for (const y of [yRow0 - 14, yRow1 + slotLength + 10]) {\n        body = body.fuse(box(bxL - 10, bxL, y, y + 4, 12, 30));\n        body = body.fuse(box(bxR, bxR + 10, y, y + 4, 12, 30));\n    }\n    // PTO flange (its face is the mounting face the shaft length is measured from)\n    body = body.fuse(replicad.makeCylinder(56, 5, [0, ptoFaceY, sh], [0, 1, 0]));\n    // Oil seal recess around the shaft\n    body = body.cut(replicad.makeCylinder(21, 2, [0, ptoFaceY - 0.01, sh], [0, 1, 0]));\n    // Crankcase cover parting line (groove round the upper case)\n    const gy = ptoFaceY + 30;\n    body = body.cut(replicad.makeCylinder(84, 1.5, [0, gy, sh], [0, 1, 0])\n        .cut(replicad.makeCylinder(80.8, 1.5, [0, gy, sh], [0, 1, 0])));\n    // Mounting holes and slots, through the feet only\n    for (const x of [xL, xR]) {\n        body = body.cut(replicad.makeCylinder(holeD / 2, 20, [x, yRow0, -4], [0, 0, 1]));\n        const slot = replicad.makeCylinder(holeD / 2, 20, [x, yRow1, -4], [0, 0, 1])\n            .fuse(replicad.makeCylinder(holeD / 2, 20, [x, yRow1 + slotLength, -4], [0, 0, 1]))\n            .fuse(box(x - holeD / 2, x + holeD / 2, yRow1, yRow1 + slotLength, -4, 16));\n        body = body.cut(slot);\n    }\n    // 4x 5/16-24 UNF tapped holes (6.9 mm tap drill, 15 mm deep) on the PTO face\n    const off = boltCircle / 2 / Math.SQRT2;\n    for (const [dx, dz] of [[off, off], [-off, off], [off, -off], [-off, -off]]) {\n        body = body.cut(replicad.makeCylinder(3.45, 16, [dx, ptoFaceY - 1, sh + dz], [0, 1, 0]));\n    }\n    // Six cover bolts on the PTO end, heads flush with the mounting face\n    for (const a of [30, 90, 150, 210, 270, 330]) {\n        const t = (a * Math.PI) / 180;\n        body = body.fuse(hex(10, 5).rotate(90, [0, 0, 0], [1, 0, 0]).translate(70 * Math.cos(t), caseY0, sh + 70 * Math.sin(t)));\n    }\n    // Oil drain plugs on both sides\n    body = body.fuse(replicad.makeCylinder(10, 5, [bxL, -50, 30], [-1, 0, 0]));\n    body = body.fuse(hex(14, 7).rotate(-90, [0, 0, 0], [0, 1, 0]).translate(bxL - 5, -50, 30));\n    body = body.fuse(replicad.makeCylinder(10, 5, [bxR, -50, 30], [1, 0, 0]));\n    body = body.fuse(hex(14, 7).rotate(90, [0, 0, 0], [0, 1, 0]).translate(bxR + 5, -50, 30));\n    // Oil fill neck and dipstick cap, angled up on the -X side\n    const dir = [-0.857, 0, 0.514];\n    const start = [-60, -50, 72];\n    const end = [start[0] + 30 * dir[0], start[1], start[2] + 30 * dir[2]];\n    body = body.fuse(replicad.makeCylinder(9, 30, start, dir));\n    body = body.fuse(replicad.makeCylinder(13, 10, end, dir));\n    body = body.fuse(replicad.makeCylinder(15, 3, end, dir));\n    return new Assembly({ geometry: body, color: \"#8C9096\", tags: [\"crankcase\"] });\n}\n"
                }
              ],
