                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-390",
                  "interpreterVersion": 1,
                  "code": "/**\n * Carburetor between the head's intake port and the air cleaner: insulator,\n * body, float bowl with drain bolt, fuel inlet nipple and choke lever.\n * Shape and position approximate.\n */\nfunction run(): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  const hex = (across, h) => {\n    try { return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h); }\n    catch (e) { return replicad.makeCylinder(across / 2, h); }\n  };\n  let c = box(108, 118.5, 10, 50, 203, 229, 3);                             // insulator plate\n  c = c.fuse(box(118, 152, 8, 52, 200, 232, 4));                            // body\n  c = c.fuse(replicad.makeCylinder(17, 33, [136, 30, 168], [0, 0, 1]));     // float bowl\n  c = c.fuse(hex(12, 8.5).translate(136, 30, 160));                        // bowl drain bolt\n  c = c.fuse(replicad.makeCylinder(3.5, 14, [120, 40, 222], [-1, 0, 0]));   // fuel inlet\n  c = c.fuse(box(126, 146, -14, 9, 228, 231, 1));                           // choke lever\n  c = c.fuse(box(126, 132, -20, -13, 222, 237, 1));                         // choke tab\n  return new Assembly({ geometry: c, color: \"#A9ACB0\", tags: [\"carburetor\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Carburetor between the head's intake port and the air cleaner: insulator,\n * body, float bowl with drain bolt, fuel inlet nipple and choke lever.\n * Shape and position approximate.\n */\nfunction run() {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    const hex = (across, h) => {\n        try {\n            return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h);\n        }\n        catch (e) {\n            return replicad.makeCylinder(across / 2, h);\n        }\n    };\n    let c = box(108, 118.5, 10, 50, 203, 229, 3); // insulator plate\n    c = c.fuse(box(118, 152, 8, 52, 200, 232, 4)); // body\n    c = c.fuse(replicad.makeCylinder(17, 33, [136, 30, 168], [0, 0, 1])); // float bowl\n    c = c.fuse(hex(12, 8.5).translate(136, 30, 160)); // bowl drain bolt\n    c = c.fuse(replicad.makeCylinder(3.5, 14, [120, 40, 222], [-1, 0, 0])); // fuel inlet\n    c = c.fuse(box(126, 146, -14, 9, 228, 231, 1)); // choke lever\n    c = c.fuse(box(126, 132, -20, -13, 222, 237, 1)); // choke tab\n    return new Assembly({ geometry: c, color: \"#A9ACB0\", tags: [\"carburetor\"] });\n}\n"
                }
              ],
              "allConnectors": [
