            },
            {
              "atomType": "Molecule",
              "x": 0.35,
              "y": 0.3,
              "uniqueID": "id-385",
              "name": "Fuel Valve and Line",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-386",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-387",
                  "ioValues": [
                    {
                      "name": "hoseRadius",
                      "ioValue": 3.5
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Fuel shutoff valve on the tank's +X side with its lever, and the fuel hose\n * to the carburetor inlet. Route approximate.\n */\nfunction run(hoseRadius: number = 3.5): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  const tube = (a, b, r) => {\n    const d = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n    const L = Math.hypot(d[0], d[1], d[2]);\n    return replicad.makeCylinder(r, L, a, d.map((v) => v / L));\n  };\n  let v = box(20, 36, 100, 120, 258, 274, 3);                  // valve body on the tank wall\n  v = v.fuse(box(35, 60, 107, 113, 262, 266, 2));              // lever\n  v = v.fuse(replicad.makeCylinder(4, 9, [28, 104, 259], [0, 0, -1])); // outlet barb\n  const pts = [[28, 104, 251], [115, 50, 252], [104, 40, 222]];\n  for (let i = 0; i < pts.length - 1; i++) v = v.fuse(tube(pts[i], pts[i + 1], hoseRadius));\n  for (const p of pts) v = v.fuse(replicad.makeSphere(hoseRadius).translate(p[0], p[1], p[2]));\n  return new Assembly({ geometry: v, color: \"#303030\", tags: [\"fuel valve\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Fuel shutoff valve on the tank's +X side with its lever, and the fuel hose\n * to the carburetor inlet. Route approximate.\n */\nfunction run(hoseRadius = 3.5) {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    const tube = (a, b, r) => {\n        const d = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n        const L = Math.hypot(d[0], d[1], d[2]);\n        return replicad.makeCylinder(r, L, a, d.map((v) => v / L));\n    };\n    let v = box(20, 36, 100, 120, 258, 274, 3); // valve body on the tank wall\n    v = v.fuse(box(35, 60, 107, 113, 262, 266, 2)); // lever\n    v = v.fuse(replicad.makeCylinder(4, 9, [28, 104, 259], [0, 0, -1])); // outlet barb\n    const pts = [[28, 104, 251], [115, 50, 252], [104, 40, 222]];\n    for (let i = 0; i < pts.length - 1; i++)\n        v = v.fuse(tube(pts[i], pts[i + 1], hoseRadius));\n    for (const p of pts)\n        v = v.fuse(replicad.makeSphere(hoseRadius).translate(p[0], p[1], p[2]));\n    return new Assembly({ geometry: v, color: \"#303030\", tags: [\"fuel valve\"] });\n}\n"
                }
              ],
