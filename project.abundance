                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-438",
                  "interpreterVersion": 1,
                  "code": "/**\n * Muffler with perforated heat shield, exhaust elbow to the head and outlet.\n * Shape and position approximate.\n */\nfunction run(): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  let m = box(100, 205, -135, -62, 120, 240, 14);\n  // Heat shield perforations on the outer face\n  for (let z = 135; z <= 215; z += 16) {\n    for (let y = -124; y <= -78; y += 12) {\n      m = m.cut(box(202, 206, y, y + 6, z, z + 9, 2.5));\n    }\n  }\n  m = m.fuse(box(110, 132, -70, -35, 198, 226, 4));                           // exhaust elbow to head\n  m = m.fuse(replicad.makeCylinder(10, 15.5, [202.5, -100, 140], [1, 0, 0])); // side outlet\n  return new Assembly({ geometry: m, color: \"#3A3A3A\", tags: [\"muffler\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Muffler with perforated heat shield, exhaust elbow to the head and outlet.\n * Shape and position approximate.\n */\nfunction run() {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    let m = box(100, 205, -135, -62, 120, 240, 14);\n    // Heat shield perforations on the outer face\n    for (let z = 135; z <= 215; z += 16) {\n        for (let y = -124; y <= -78; y += 12) {\n            m = m.cut(box(202, 206, y, y + 6, z, z + 9, 2.5));\n        }\n    }\n    m = m.fuse(box(110, 132, -70, -35, 198, 226, 4)); // exhaust elbow to head\n    m = m.fuse(replicad.makeCylinder(10, 15.5, [202.5, -100, 140], [1, 0, 0])); // side outlet\n    return new Assembly({ geometry: m, color: \"#3A3A3A\", tags: [\"muffler\"] });\n}\n"
                }
