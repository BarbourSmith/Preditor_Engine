                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-435",
                  "interpreterVersion": 1,
                  "code": "/**\n * Engine ON/OFF rocker switch on the -X side of the blower housing.\n * Position approximate.\n */\nfunction run(): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  let s = box(-104, -86, 118, 142, 138, 166, 3);    // switch housing\n  s = s.fuse(box(-108, -104, 123, 137, 145, 159, 1)); // rocker\n  return new Assembly({ geometry: s, color: \"#C62828\", tags: [\"engine switch\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Engine ON/OFF rocker switch on the -X side of the blower housing.\n * Position approximate.\n */\nfunction run() {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    let s = box(-104, -86, 118, 142, 138, 166, 3); // switch housing\n    s = s.fuse(box(-108, -104, 123, 137, 145, 159, 1)); // rocker\n    return new Assembly({ geometry: s, color: \"#C62828\", tags: [\"engine switch\"] });\n}\n"
                }
              ],
