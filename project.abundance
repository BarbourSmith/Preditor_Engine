            {
              "atomType": "Molecule",
              "x": 0.3214,
              "y": 0.3408,
              "uniqueID": "id-430",
              "name": "Throttle Control",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-431",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-432",
                  "interpreterVersion": 1,
                  "code": "/**\n * Throttle lever: a small flat tab on the governor bracket just under the air\n * filter, above the choke and fuel valve (manual p.6 inset, p.10 step 3).\n * Slides between SLOW (turtle) and FAST (rabbit). Size and position approximate.\n */\nfunction run(): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  let t = replicad.makeCylinder(6, 4, [158, 100, 183], [0, 0, 1]); // pivot under the air filter\n  t = t.fuse(box(158, 214, 94, 106, 184, 186.5, 2));                // flat lever arm\n  t = t.fuse(box(210, 214, 94, 106, 174, 186.5, 1));                // bent-down finger tab\n  return new Assembly({ geometry: t, color: \"#2B2B2B\", tags: [\"throttle\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Throttle lever: a small flat tab on the governor bracket just under the air\n * filter, above the choke and fuel valve (manual p.6 inset, p.10 step 3).\n * Slides between SLOW (turtle) and FAST (rabbit). Size and position approximate.\n */\nfunction run() {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    let t = replicad.makeCylinder(6, 4, [158, 100, 183], [0, 0, 1]); // pivot under the air filter\n    t = t.fuse(box(158, 214, 94, 106, 184, 186.5, 2)); // flat lever arm\n    t = t.fuse(box(210, 214, 94, 106, 174, 186.5, 1)); // bent-down finger tab\n    return new Assembly({ geometry: t, color: \"#2B2B2B\", tags: [\"throttle\"] });\n}\n"
                }
              ],
