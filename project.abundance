            },
            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.39,
              "uniqueID": "id-331",
              "name": "Cylinder and Head",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-332",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-333",
                  "ioValues": [
                    {
                      "name": "tiltDeg",
                      "ioValue": 25
                    },
                    {
                      "name": "shaftHeight",
                      "ioValue": 106
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Finned cylinder barrel, finned head, valve cover with bolts, spark plug boss\n * and intake/exhaust port bosses. Built along local +Z from the crank axis, then\n * leaned toward +X (carburetor and muffler side). Bore 70 mm per manual;\n * external shape approximate. Small features are sunk slightly into the faces\n * they sit on so no faces coincide.\n */\nfunction run(tiltDeg: number = 25, shaftHeight: number = 106): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  const hex = (across, h) => {\n    try { return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h); }\n    catch (e) { return replicad.makeCylinder(across / 2, h); }\n  };\n  let g = replicad.makeCylinder(46, 90, [0, 0, 55], [0, 0, 1]);              // barrel core\n  for (let z = 64; z < 138; z += 9) g = g.fuse(box(-56, 56, -54, 54, z, z + 3, 10)); // barrel fins\n  g = g.fuse(box(-58, 58, -56, 56, 139, 179, 8));                            // cylinder head\n  for (const z of [146, 153, 160, 167]) g = g.fuse(box(-62, 62, -60, 60, z, z + 2.5, 11)); // head fins\n  g = g.fuse(box(-60, 60, -58, 58, 177, 182, 9.5));                          // gasket flange\n  g = g.fuse(box(-46, 50, -48, 48, 181, 200, 10));                           // valve cover\n  for (const [x, y] of [[-34, -36], [-34, 36], [38, -36], [38, 36]]) {\n    g = g.fuse(hex(10, 5.5).translate(x, y, 199.5));                         // valve cover bolts\n  }\n  g = g.fuse(replicad.makeCylinder(5, 14, [6, 0, 199], [0, 0, 1]));          // breather nipple\n  g = g.fuse(box(55, 80, 5, 45, 144, 176, 5));                               // intake port boss\n  g = g.fuse(box(55, 80, -45, -5, 144, 176, 5));                             // exhaust port boss\n  g = g.fuse(replicad.makeCylinder(13, 7, [0, -55, 163.5], [0, -1, 0]));     // spark plug boss\n  g = g.rotate(tiltDeg, [0, 0, 0], [0, 1, 0]).translate(0, 0, shaftHeight);\n  return new Assembly({ geometry: g, color: \"#7E8288\", tags: [\"cylinder\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Finned cylinder barrel, finned head, valve cover with bolts, spark plug boss\n * and intake/exhaust port bosses. Built along local +Z from the crank axis, then\n * leaned toward +X (carburetor and muffler side). Bore 70 mm per manual;\n * external shape approximate. Small features are sunk slightly into the faces\n * they sit on so no faces coincide.\n */\nfunction run(tiltDeg = 25, shaftHeight = 106) {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    const hex = (across, h) => {\n        try {\n            return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h);\n        }\n        catch (e) {\n            return replicad.makeCylinder(across / 2, h);\n        }\n    };\n    let g = replicad.makeCylinder(46, 90, [0, 0, 55], [0, 0, 1]); // barrel core\n    for (let z = 64; z < 138; z += 9)\n        g = g.fuse(box(-56, 56, -54, 54, z, z + 3, 10)); // barrel fins\n    g = g.fuse(box(-58, 58, -56, 56, 139, 179, 8)); // cylinder head\n    for (const z of [146, 153, 160, 167])\n        g = g.fuse(box(-62, 62, -60, 60, z, z + 2.5, 11)); // head fins\n    g = g.fuse(box(-60, 60, -58, 58, 177, 182, 9.5)); // gasket flange\n    g = g.fuse(box(-46, 50, -48, 48, 181, 200, 10)); // valve cover\n    for (const [x, y] of [[-34, -36], [-34, 36], [38, -36], [38, 36]]) {\n        g = g.fuse(hex(10, 5.5).translate(x, y, 199.5)); // valve cover bolts\n    }\n    g = g.fuse(replicad.makeCylinder(5, 14, [6, 0, 199], [0, 0, 1])); // breather nipple\n    g = g.fuse(box(55, 80, 5, 45, 144, 176, 5)); // intake port boss\n    g = g.fuse(box(55, 80, -45, -5, 144, 176, 5)); // exhaust port boss\n    g = g.fuse(replicad.makeCylinder(13, 7, [0, -55, 163.5], [0, -1, 0])); // spark plug boss\n    g = g.rotate(tiltDeg, [0, 0, 0], [0, 1, 0]).translate(0, 0, shaftHeight);\n    return new Assembly({ geometry: g, color: \"#7E8288\", tags: [\"cylinder\"] });\n}\n"
                }
              ],
