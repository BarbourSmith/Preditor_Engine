            },
            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.63,
              "uniqueID": "id-427",
              "name": "Recoil Starter Housing",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-428",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-429",
                  "ioValues": [
                    {
                      "name": "shaftHeight",
                      "ioValue": 106
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Blower housing over the flywheel, vented recoil starter cup, housing bolts,\n * rope guide and pull handle. The starter cup's back face sets the engine's\n * length along the crank, 317.5 mm (12.5 in) from the PTO shaft end per\n * retailer listings. Shape approximate.\n */\nfunction run(shaftHeight: number = 106): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  const hex = (across, h) => {\n    try { return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h); }\n    catch (e) { return replicad.makeCylinder(across / 2, h); }\n  };\n  const sh = shaftHeight;\n  let h = replicad.makeCylinder(100, 102, [0, 58, sh], [0, 1, 0]);          // flywheel cover, Y 58-160\n  h = h.fuse(box(-100, 125, 58, 150, sh, 250, 25));                          // shroud over the cylinder\n  h = h.fuse(replicad.makeCylinder(103, 4, [0, 58, sh], [0, 1, 0]));        // housing flange\n  // Recoil starter cup, back face at Y 176, with radial vents and a recessed hub\n  let cup = replicad.makeCylinder(72, 16, [0, 160, sh], [0, 1, 0]);\n  for (let i = 0; i < 12; i++) {\n    cup = cup.cut(box(-2.5, 2.5, 172, 177, sh + 36, sh + 64).rotate(i * 30, [0, 0, sh], [0, 1, 0]));\n  }\n  cup = cup.cut(replicad.makeCylinder(22, 4, [0, 173, sh], [0, 1, 0]));\n  cup = cup.fuse(replicad.makeCylinder(9, 4, [0, 172, sh], [0, 1, 0]));\n  h = h.fuse(cup);\n  // Three cup-mounting bolts on the flywheel cover face\n  for (const a of [90, 210, 330]) {\n    const t = (a * Math.PI) / 180;\n    h = h.fuse(hex(10, 4).rotate(-90, [0, 0, 0], [1, 0, 0]).translate(86 * Math.cos(t), 160, sh + 86 * Math.sin(t)));\n  }\n  // Rope guide and T pull handle\n  h = h.fuse(replicad.makeCylinder(9, 12, [95, 150, 215], [0, 1, 0]));\n  h = h.fuse(replicad.makeCylinder(8, 64, [63, 168, 225], [1, 0, 0]));\n  h = h.fuse(replicad.makeCylinder(5, 12, [95, 160, 215], [0, 1, 0.8]));\n  return new Assembly({ geometry: h, color: \"#2B2B2B\", tags: [\"recoil housing\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Blower housing over the flywheel, vented recoil starter cup, housing bolts,\n * rope guide and pull handle. The starter cup's back face sets the engine's\n * length along the crank, 317.5 mm (12.5 in) from the PTO shaft end per\n * retailer listings. Shape approximate.\n */\nfunction run(shaftHeight = 106) {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    const hex = (across, h) => {\n        try {\n            return replicad.drawPolysides(across / Math.sqrt(3), 6).sketchOnPlane(\"XY\").extrude(h);\n        }\n        catch (e) {\n            return replicad.makeCylinder(across / 2, h);\n        }\n    };\n    const sh = shaftHeight;\n    let h = replicad.makeCylinder(100, 102, [0, 58, sh], [0, 1, 0]); // flywheel cover, Y 58-160\n    h = h.fuse(box(-100, 125, 58, 150, sh, 250, 25)); // shroud over the cylinder\n    h = h.fuse(replicad.makeCylinder(103, 4, [0, 58, sh], [0, 1, 0])); // housing flange\n    // Recoil starter cup, back face at Y 176, with radial vents and a recessed hub\n    let cup = replicad.makeCylinder(72, 16, [0, 160, sh], [0, 1, 0]);\n    for (let i = 0; i < 12; i++) {\n        cup = cup.cut(box(-2.5, 2.5, 172, 177, sh + 36, sh + 64).rotate(i * 30, [0, 0, sh], [0, 1, 0]));\n    }\n    cup = cup.cut(replicad.makeCylinder(22, 4, [0, 173, sh], [0, 1, 0]));\n    cup = cup.fuse(replicad.makeCylinder(9, 4, [0, 172, sh], [0, 1, 0]));\n    h = h.fuse(cup);\n    // Three cup-mounting bolts on the flywheel cover face\n    for (const a of [90, 210, 330]) {\n        const t = (a * Math.PI) / 180;\n        h = h.fuse(hex(10, 4).rotate(-90, [0, 0, 0], [1, 0, 0]).translate(86 * Math.cos(t), 160, sh + 86 * Math.sin(t)));\n    }\n    // Rope guide and T pull handle\n    h = h.fuse(replicad.makeCylinder(9, 12, [95, 150, 215], [0, 1, 0]));\n    h = h.fuse(replicad.makeCylinder(8, 64, [63, 168, 225], [1, 0, 0]));\n    h = h.fuse(replicad.makeCylinder(5, 12, [95, 160, 215], [0, 1, 0.8]));\n    return new Assembly({ geometry: h, color: \"#2B2B2B\", tags: [\"recoil housing\"] });\n}\n"
                }
              ],
              "allConnectors": [
