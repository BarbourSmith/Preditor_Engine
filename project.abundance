        {
          "atomType": "Molecule",
          "x": 0.3,
          "y": 0.75,
          "uniqueID": "id-423",
          "name": "Starter, Controls and Exhaust",
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 0.98,
              "y": 0.5,
              "uniqueID": "id-425",
              "ioValues": [
                {
