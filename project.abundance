            },
            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.51,
              "uniqueID": "id-382",
              "name": "Fuel Tank",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-383",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-384",
                  "interpreterVersion": 1,
                  "code": "/**\n * Fuel tank (0.9 gal) with seam lip and ribbed filler cap. The lip's -X edge\n * and the top of the cap set the engine's overall width and height (368 mm /\n * 14.5 in and 356 mm / 14 in per retailer listings). Shape approximate.\n */\nfunction run(): Assembly {\n  const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n    const w = x1 - x0, d = y1 - y0;\n    const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n    return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n  };\n  let t = box(-148.5, 20, -40, 160, 255, 330, 28);\n  try { t = t.fillet(12, (e) => e.inPlane(\"XY\", 330)); } catch (err) { console.warn(\"tank top fillet skipped\"); }\n  try { t = t.fillet(6, (e) => e.inPlane(\"XY\", 255)); } catch (err) { console.warn(\"tank bottom fillet skipped\"); }\n  t = t.fuse(box(-150, 21.5, -41.5, 161.5, 288, 292, 29.5));               // seam lip\n  const cx = -65, cy = 60;\n  t = t.fuse(replicad.makeCylinder(22, 8, [cx, cy, 328], [0, 0, 1]));       // filler neck\n  let cap = replicad.makeCylinder(28, 20, [cx, cy, 336], [0, 0, 1]);        // cap, top at Z 356\n  for (let i = 0; i < 16; i++) {\n    cap = cap.cut(box(cx + 25.5, cx + 30, cy - 1.75, cy + 1.75, 338, 357).rotate(i * 22.5, [cx, cy, 0], [0, 0, 1]));\n  }\n  t = t.fuse(cap);\n  return new Assembly({ geometry: t, color: \"#1E1E1E\", tags: [\"fuel tank\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Fuel tank (0.9 gal) with seam lip and ribbed filler cap. The lip's -X edge\n * and the top of the cap set the engine's overall width and height (368 mm /\n * 14.5 in and 356 mm / 14 in per retailer listings). Shape approximate.\n */\nfunction run() {\n    const box = (x0, x1, y0, y1, z0, z1, r = 0) => {\n        const w = x1 - x0, d = y1 - y0;\n        const dr = r > 0 ? replicad.drawRoundedRectangle(w, d, r) : replicad.drawRectangle(w, d);\n        return dr.sketchOnPlane(\"XY\", z0).extrude(z1 - z0).translate((x0 + x1) / 2, (y0 + y1) / 2, 0);\n    };\n    let t = box(-148.5, 20, -40, 160, 255, 330, 28);\n    try {\n        t = t.fillet(12, (e) => e.inPlane(\"XY\", 330));\n    }\n    catch (err) {\n        console.warn(\"tank top fillet skipped\");\n    }\n    try {\n        t = t.fillet(6, (e) => e.inPlane(\"XY\", 255));\n    }\n    catch (err) {\n        console.warn(\"tank bottom fillet skipped\");\n    }\n    t = t.fuse(box(-150, 21.5, -41.5, 161.5, 288, 292, 29.5)); // seam lip\n    const cx = -65, cy = 60;\n    t = t.fuse(replicad.makeCylinder(22, 8, [cx, cy, 328], [0, 0, 1])); // filler neck\n    let cap = replicad.makeCylinder(28, 20, [cx, cy, 336], [0, 0, 1]); // cap, top at Z 356\n    for (let i = 0; i < 16; i++) {\n        cap = cap.cut(box(cx + 25.5, cx + 30, cy - 1.75, cy + 1.75, 338, 357).rotate(i * 22.5, [cx, cy, 0], [0, 0, 1]));\n    }\n    t = t.fuse(cap);\n    return new Assembly({ geometry: t, color: \"#1E1E1E\", tags: [\"fuel tank\"] });\n}\n"
                }
              ],
              "allConnectors": [
