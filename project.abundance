            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.27,
              "uniqueID": "id-328",
              "name": "PTO Shaft",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 0.98,
                  "y": 0.5,
                  "uniqueID": "id-329",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.4,
                  "y": 0.5,
                  "uniqueID": "id-330",
                  "ioValues": [
                    {
                      "name": "ptoFaceY",
                      "ioValue": -80
                    },
                    {
                      "name": "shaftHeight",
                      "ioValue": 106
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * PTO crankshaft end. Exact per manual p.21: 19.05 mm (3/4\") diameter,\n * 61.7 mm out of the PTO face, 4.78 mm (3/16\") keyway 45.5 mm long from the end,\n * 16.36 mm across keyway bottom to opposite side, 5/16-24 UNF center hole 17 mm deep.\n */\nfunction run(ptoFaceY: number = -80, shaftHeight: number = 106): Assembly {\n  const r = 19.05 / 2, len = 61.7, endY = ptoFaceY - len;\n  let s = replicad.makeCylinder(r, len + 20, [0, endY, shaftHeight], [0, 1, 0]);\n  const kw = 4.78, keyLen = 45.5, across = 16.36;\n  const keyBottom = shaftHeight - r + across;\n  const key = replicad.drawRectangle(kw, keyLen + 1).sketchOnPlane(\"XY\", keyBottom).extrude(10)\n    .translate(0, endY + (keyLen - 1) / 2, 0);\n  s = s.cut(key);\n  s = s.cut(replicad.makeCylinder(6.9 / 2, 18, [0, endY - 1, shaftHeight], [0, 1, 0]));\n  return new Assembly({ geometry: s, color: \"#C3C7CC\", tags: [\"shaft\"] });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * PTO crankshaft end. Exact per manual p.21: 19.05 mm (3/4\") diameter,\n * 61.7 mm out of the PTO face, 4.78 mm (3/16\") keyway 45.5 mm long from the end,\n * 16.36 mm across keyway bottom to opposite side, 5/16-24 UNF center hole 17 mm deep.\n */\nfunction run(ptoFaceY = -80, shaftHeight = 106) {\n    const r = 19.05 / 2, len = 61.7, endY = ptoFaceY - len;\n    let s = replicad.makeCylinder(r, len + 20, [0, endY, shaftHeight], [0, 1, 0]);\n    const kw = 4.78, keyLen = 45.5, across = 16.36;\n    const keyBottom = shaftHeight - r + across;\n    const key = replicad.drawRectangle(kw, keyLen + 1).sketchOnPlane(\"XY\", keyBottom).extrude(10)\n        .translate(0, endY + (keyLen - 1) / 2, 0);\n    s = s.cut(key);\n    s = s.cut(replicad.makeCylinder(6.9 / 2, 18, [0, endY - 1, shaftHeight], [0, 1, 0]));\n    return new Assembly({ geometry: s, color: \"#C3C7CC\", tags: [\"shaft\"] });\n}\n"
                }
              ],
              "allConnectors": [
                {
                  "ap2Name": "number or geometry",
